# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# YouTube Data API v3 (for searching/reading playlists)
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth 2.0 (for creating/modifying playlists)
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret_here
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5000/youtube_callback

# Flask Configuration
FLASK_SECRET_KEY=your_random_secret_key_here
PORT=8000
